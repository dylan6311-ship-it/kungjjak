{
  "permissions": {
    "allow": [
      "Bash(pdftotext:*)",
      "Bash(python3 scripts/sync_notebook.py:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in */index.html) python3 \"$CLAUDE_PROJECT_DIR/scripts/sync_notebook.py\" ;; esac; exit 0"
          }
        ]
      }
    ]
  }
}
